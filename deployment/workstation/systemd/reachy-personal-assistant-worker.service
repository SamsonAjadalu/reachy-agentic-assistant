# Optional worker-only unit. Use when the API process should not run the background
# worker in-process (WORKER_ENABLED=false on the API unit).
#
# This unit starts the same FastAPI application but disables the scheduler and enables
# only the worker. It does NOT start the Telegram listener — that requires the process
# that owns the scheduler lock (see reachy-personal-assistant-api.service).
#
# Only one process may hold the scheduler lock at ${APP_DATA_DIR}/scheduler.lock.
# Running this unit alongside the API unit is the supported split layout:
#   API:    SCHEDULER_ENABLED=true,  WORKER_ENABLED=false
#   Worker: SCHEDULER_ENABLED=false, WORKER_ENABLED=true
#
# Do NOT enable this unit when the API already runs with WORKER_ENABLED=true (default).

[Unit]
Description=Reachy Personal Assistant background worker
Documentation=file://@REPO_ROOT@/docs/operations.md
After=network-online.target reachy-personal-assistant-api.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@REPO_ROOT@
# Defaults first; EnvironmentFile may override.
Environment=APP_HOST=127.0.0.1
Environment=APP_PORT=8081
EnvironmentFile=-@ENV_FILE@
Environment=APP_DATA_DIR=@APP_DATA_DIR@
Environment=PA_SECRET_KEY_FILE=${CREDENTIALS_DIRECTORY}/pa_secret_key
LoadCredential=pa_secret_key:@SECRET_KEY_FILE@

Environment=SCHEDULER_ENABLED=false
Environment=WORKER_ENABLED=true

ExecStart=@PYTHON@ -m uvicorn app.main:app --host ${APP_HOST} --port ${APP_PORT}
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
