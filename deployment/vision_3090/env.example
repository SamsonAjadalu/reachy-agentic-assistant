# Perception sidecar for a CUDA GPU host (optional remote worker).
# Copy this file to your local configuration directory, for example:
#   %LOCALAPPDATA%\reachy-vision-sidecar\.env   (Windows)
#   ~/.local/share/reachy-vision-sidecar/.env   (Linux)
# Use the dedicated vision-sidecar environment for this host.

APP_ENV=production
APP_DATA_DIR=<path-outside-repo>/reachy-vision-sidecar
MOCK_MODE=false
VISION_MOCK_MODE=false
VISION_ALLOW_DOWNLOADS=true
VISION_DEVICE=cuda:0
VISION_CPU_FALLBACK=true
VISION_SERIAL_GPU=true
VISION_KEEP_LOADED=true
VISION_SIDECAR_HOST=0.0.0.0
VISION_SIDECAR_PORT=8090
VISION_SIDECAR_ALLOW_NONLOCAL=true
# Restrict to your LAN / VPN CIDRs; token auth is still required.
PA_API_ALLOWED_NETWORKS=127.0.0.0/8,<your-lan-cidr>
# Set VISION_SIDECAR_TOKEN to a long random secret shared with the workstation.
VISION_SIDECAR_TOKEN=
DETECTION_PROVIDER=grounding_dino
SEGMENTATION_PROVIDER=sam2
DEPTH_PROVIDER=da3mono_large
EMBEDDING_PROVIDER=dinov2
GROUNDING_DINO_ENABLED=true
SAM2_ENABLED=true
DA3_ENABLED=true
DINOV2_ENABLED=true
YOLO_WORLD_ENABLED=false
