# Reachy Agentic Assistant - workstation configuration
#
# Prefer: ./scripts/install.sh  (creates .env once and preserves existing files)
# Or:     cp .env.example .env
#
# Keep .env local. After live edits: uv run python scripts/check_configuration.py

# ---------------------------------------------------------------- application
APP_ENV=development                 # development | test | production
APP_HOST=127.0.0.1                  # 0.0.0.0 only behind Tailscale or a proxy
APP_PORT=8080
APP_LOG_LEVEL=INFO
APP_LOG_FORMAT=json                 # json | console
APP_TIMEZONE=UTC

# All mutable runtime state. Keep this directory separate from the application code: it holds the
# SQLite databases, the encrypted token store, wardrobe images, the document
# index, task outputs, caches and backups.
APP_DATA_DIR=~/.local/share/reachy-personal-assistant

# Defaults to sqlite+aiosqlite:///${APP_DATA_DIR}/assistant.db
DATABASE_URL=

# ------------------------------------------------------------------- security
# Generate with: python scripts/generate_api_token.py
PA_API_TOKEN=changeme-generate-a-real-token
PA_API_ALLOWED_NETWORKS=127.0.0.0/8,::1/128,192.168.0.0/16,100.64.0.0/10
PA_RATE_LIMIT_PER_MINUTE=240
PA_MAX_REQUEST_BYTES=2097152

# Fernet key protecting the OAuth token store. Pick exactly ONE source.
# Store it separately from APP_DATA_DIR, so data backups contain only the
# encrypted store.
#
#   1. systemd (recommended in production). The unit ships
#      LoadCredential=pa_secret_key:/etc/reachy-personal-assistant/secret.key
#      and systemd exposes it on a private tmpfs:
# PA_SECRET_KEY_FILE=${CREDENTIALS_DIRECTORY}/pa_secret_key
#
#   2. A protected file outside APP_DATA_DIR (chmod 600):
# PA_SECRET_KEY_FILE=/etc/reachy-personal-assistant/secret.key
#
#   3. The OS keyring (needs: uv pip install keyring):
# PA_SECRET_KEY_KEYRING=true
#
#   4. Development only - the key directly in the environment:
PA_SECRET_KEY=

# --------------------------------------------------------------------- runtime
# Force every external provider to its mock implementation. Refused in production.
MOCK_MODE=true
SCHEDULER_ENABLED=true
WORKER_ENABLED=true
WORKER_CONCURRENCY=2
WORKER_LEASE_SECONDS=300

# -------------------------------------------------------------------- telegram
# From @BotFather. See docs/telegram_setup.md.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
# Only these chat ids may receive messages or resolve approvals.
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_APPROVAL_TTL_MINUTES=60

# Forward normal Telegram text to the Reachy Pi conversation session.
REACHY_TEXT_TURN_ENABLED=false
REACHY_TEXT_TURN_URL=http://reachy-mini.local:7861/api/v1/text-turn
REACHY_TEXT_TURN_TOKEN=
REACHY_TEXT_TURN_TIMEOUT_SECONDS=90

# Pi camera (visual memory adapter v1). Paths are draft defaults until the Pi
# report lands. Wired into app.config.Settings as reachy_camera_*.
REACHY_CAMERA_ENABLED=false
REACHY_CAMERA_URL=http://reachy-mini.local:7861
REACHY_VISION_TOKEN=
REACHY_CAMERA_TOKEN=
REACHY_CAMERA_TIMEOUT_SECONDS=10
REACHY_CAMERA_CONNECT_TIMEOUT_SECONDS=5
REACHY_CAMERA_MAX_BODY_BYTES=5242880
REACHY_CAMERA_STALE_FRAME_MS=1000
REACHY_CAMERA_FRAME_PATH=/api/v1/camera/frame
REACHY_CAMERA_FRAME_METHOD=POST
REACHY_CAMERA_STATUS_PATH=/api/v1/camera/status
REACHY_CAMERA_SCAN_PATH=/api/v1/scan
REACHY_CAMERA_SCAN_STATUS_PATH=/api/v1/scan/{scan_id}
REACHY_CAMERA_SCAN_CANCEL_PATH=/api/v1/scan/{scan_id}/cancel
REACHY_CAMERA_GET_ATTEMPTS=2

# ---------------------------------------------------------------------- google
# From Google Cloud Console. See docs/google_setup.md.
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8765/oauth2callback
# Defaults to ${APP_DATA_DIR}/secrets/google_tokens.enc
GOOGLE_TOKEN_STORE_PATH=

# ---------------------------------------------------------------------- notion
# Internal integration token. See docs/notion_setup.md.
NOTION_ENABLED=false
NOTION_TOKEN=
# Only these page or database ids are reachable, even if more are shared.
NOTION_ALLOWED_PAGE_IDS=
NOTION_CACHE_TTL_SECONDS=300

# --------------------------------------------------------------------- weather
# open_meteo needs no API key and is the default.
WEATHER_PROVIDER=open_meteo
WEATHER_API_KEY=
WEATHER_DEFAULT_LOCATION=
WEATHER_DEFAULT_LATITUDE=
WEATHER_DEFAULT_LONGITUDE=
WEATHER_CACHE_TTL_SECONDS=900

# ------------------------------------------------------------ local resources
# Defaults to ${APP_DATA_DIR}/wardrobe
WARDROBE_IMAGE_ROOT=
# Comma-separated roots the document indexer may walk. Nothing outside these
# directories is readable, and symlinks out of them are rejected.
DOCUMENT_INDEX_ROOTS=
DOCUMENT_MAX_BYTES=52428800
DOCUMENT_FOLLOW_SYMLINKS=false
# How often the scheduler queues an incremental re-index. Only changed files are
# re-read, so an hour is cheap even over a large folder.
DOCUMENT_INDEX_INTERVAL_SECONDS=3600

# Max bytes for a single Gmail attachment download into APP_DATA_DIR.
GMAIL_ATTACHMENT_MAX_BYTES=15728640

# Defaults to ${APP_DATA_DIR}/backups
BACKUP_ROOT=
BACKUP_RETENTION_DAYS=30

# Allowlist of local operations. Only listed operations are executable.
WORKSTATION_SCRIPT_REGISTRY=config/registered_scripts.yaml
# Comma-separated systemd unit names whose status may be read. Reading only;
# the assistant reads service status.
WORKSTATION_ALLOWED_SERVICES=
# Whether those units are user or system scope.
WORKSTATION_SERVICE_SCOPE=user
# Per-run cap on captured output. The rest goes to the run's log file only.
WORKSTATION_MAX_OUTPUT_BYTES=65536
WORKSTATION_MAX_CONCURRENT_RUNS=2
WORKSTATION_DEFAULT_TIMEOUT_SECONDS=300
BRIEFING_CONFIG_PATH=config/briefing.yaml

# ----------------------------------------------------------- visual memory
# Off by default. Persistence is keyframes only; ~1 Hz sampling is ephemeral.
VISUAL_ENABLED=false
# Floor is 10 seconds. 1 Hz observation rows are refused.
VISUAL_MIN_CAPTURE_INTERVAL_SECONDS=10
# Change-detection sampling. Only changed frames are written to the database.
VISUAL_SAMPLING_HZ=1.0
VISUAL_EPHEMERAL_RETENTION_MINUTES=60
VISUAL_THUMBNAIL_RETENTION_DAYS=30
VISUAL_EVIDENCE_RETENTION_DAYS=90
# Hard byte budget for active files under ${APP_DATA_DIR}/visual/evidence.
VISUAL_EVIDENCE_MAX_BYTES=2147483648
VISUAL_KEEP_FULL_FRAMES=false
VISUAL_DAILY_OBSERVATION_CAP=2000

# ---------------------------------------------------------- vision sidecar
# Separate process on 127.0.0.1:8090. FastAPI uses an in-process mock unless
# VISUAL_SIDECAR_ENABLED=true. Falls back to PA_API_TOKEN if unset. Tokens stay out of logs.
VISION_SIDECAR_TOKEN=
VISION_SIDECAR_HOST=127.0.0.1
# Remote GPU host example: VISION_SIDECAR_HOST=<your-sidecar-host>
VISION_SIDECAR_PORT=8090
# Real providers need .venv-vision and VISION_ALLOW_DOWNLOADS after catalogue verify.
VISION_ALLOW_DOWNLOADS=false
YOLO_WORLD_ENABLED=false
VISUAL_SCAN_HOURLY_CAP=6
VISUAL_WATCH_POLL_SECONDS=60
VISUAL_NEED_LOOK_THRESHOLD=0.55
VISUAL_RETENTION_UNLINK_THRESHOLD=10
VISUAL_SIDECAR_ENABLED=false
VISION_SIDECAR_TIMEOUT_SECONDS=180

