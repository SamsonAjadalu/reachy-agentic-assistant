# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
.venv-vision/
venv/

# Secrets / local config — never commit
.env
.env.*
!.env.example
.env.local
.env.live
*.local.yaml
*.local.yml

# Local databases
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Logs and run artifacts
*.log
*.pid
logs/
mock-api.log
mock-api.pid

# Tooling / generated reports
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Runtime data (must live outside the checkout via APP_DATA_DIR;
# these patterns only guard accidental local copies)
data/**
!data/.gitkeep
!data/README.md
**/visual/evidence/
**/evidence/thumbnail/
**/evidence/full/
wardrobe_images/
document_index/
secrets/
*token_store*.enc
*_tokens.enc
client_secret*.json
credentials.json
token.json
*.pem
*.key
!tests/fixtures/**/*.key

# Images / evidence dumps
*.jpg
*.jpeg
*.png
*.webp
!docs/**/*.png
!docs/**/*.jpg
!tests/fixtures/**

# Model caches / weights
*.safetensors
*.onnx
*.ckpt
*.pt
*.pth
*.bin
